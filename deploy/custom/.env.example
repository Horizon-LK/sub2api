# Template only. Generate independent random hex values on the server.
# Real file: /opt/sub2api/.env, owned by root with mode 0600. Do not commit it.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ADMIN_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

# Create sub2api-prod-backend first; inspect its gateway and append /32.
TRUSTED_PROXY_CIDR=

# Pin these to the pulled official repository digests before production startup.
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
